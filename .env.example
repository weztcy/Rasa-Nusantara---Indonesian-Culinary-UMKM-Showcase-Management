# ========================================================
# ENVIRONMENT VARIABLES - DOCKER COMPOSE (.env.example)
# Showcase Produk Makanan UMKM Nusantara (RasaNusantara)
# ========================================================

# --- 1. Database MySQL Container ---
DB_ROOT_PASSWORD=rootpassword
DB_NAME=rasanusantara_db
DB_USER=umkm_user
DB_PASSWORD=umkm_password
DB_PORT=3306

# --- 2. Backend Express API Container ---
PORT=5000
NODE_ENV=production
JWT_SECRET=ganti_dengan_jwt_secret_rahasia_anda_di_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# --- 3. Frontend Next.js Container ---
FRONTEND_PORT=3000

# URL komunikasi internal Docker network ke backend (menggunakan nama service 'backend', BUKAN localhost):
INTERNAL_API_URL=http://backend:5000

# Endpoint API untuk browser (default: /api diteruskan melalui reverse proxy Next.js internal):
NEXT_PUBLIC_API_URL=/api
